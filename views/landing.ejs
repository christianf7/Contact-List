<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Contact List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg,#667eea,#764ba2,#ff6cab);
        background-size: 400% 400%;
        animation: gradient 15s ease infinite;
      }
      @keyframes gradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
    </style>
  </head>
  <body class="d-flex flex-column justify-content-center align-items-center vh-100 text-center text-white">
    <div class="bg-white bg-opacity-10 backdrop-blur rounded shadow-lg p-5" style="max-width: 500px;">
      <i class="fa-solid fa-address-card fa-3x mb-3"></i>
      <h1 class="mb-3 fw-bold text-white">Contact List</h1>
      <p class="mb-4">Capture and manage contacts with ease.</p>
      <div class="d-flex justify-content-center gap-3">
        <a class="btn btn-outline-light" href="https://github.com/christianf7/Contact-List" target="_blank" rel="noopener"><i class="fab fa-github me-1"></i>GitHub</a>
        <a class="btn btn-light" href="/login">Log In</a>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Users</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
      <div class="container-fluid">
        <span class="navbar-brand">Users</span>
        <div class="d-flex">
          <a class="btn btn-outline-light me-2" href="/contacts">Contacts</a>
          <a class="btn btn-outline-light" href="/logout">Logout</a>
        </div>
      </div>
    </nav>

    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="m-0">Users</h1>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">Add User</button>
      </div>

      <div class="card">
        <div class="card-body p-0">
          <table class="table table-striped mb-0 align-middle">
            <thead>
              <tr>
                <th>Username</th>
                <th class="text-center">Admin</th>
                <th>Created</th>
                <th>Created By</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
                <tr>
                  <td><%= u.username %></td>
                  <td class="text-center"><%= u.isAdmin ? '✓' : '' %></td>
                  <td><%= u.createdAt ? new Date(u.createdAt).toLocaleString('en-AU', { timeZone: 'Australia/Brisbane' }) : 'N/A' %></td>
                  <td><%= u.createdBy || 'N/A' %></td>
                  <td>
                    <div class="d-flex gap-2">
                      <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#edit-<%= u._id %>">Edit</button>
                      <% if (u.username !== currentUser) { %>
                        <form action="/users/<%= u._id %>/delete" method="post" onsubmit="return confirm('Delete user?');">
                          <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <% users.forEach(u => { %>
      <div class="modal fade" id="edit-<%= u._id %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
          <form class="modal-content" action="/users/<%= u._id %>/edit" method="post">
            <div class="modal-header">
              <h5 class="modal-title">Edit User</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Username</label>
                <input class="form-control" type="text" name="username" value="<%= u.username %>" required />
              </div>
              <div class="mb-3">
                <label class="form-label">New Password</label>
                <input class="form-control" type="password" name="password" placeholder="Password" />
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="isAdmin-<%= u._id %>" name="isAdmin" <%= u.isAdmin ? 'checked' : '' %> />
                <label class="form-check-label" for="isAdmin-<%= u._id %>">Admin</label>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Save</button>
            </div>
          </form>
        </div>
      </div>
    <% }) %>

    <div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog">
        <form class="modal-content" action="/users/add" method="post">
          <div class="modal-header">
            <h5 class="modal-title">Add User</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Username</label>
              <input class="form-control" type="text" name="username" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Password</label>
              <input class="form-control" type="password" name="password" required />
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="newIsAdmin" name="isAdmin" />
              <label class="form-check-label" for="newIsAdmin">Admin</label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Add</button>
          </div>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Users</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body class="bg-light">
    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="m-0">Users</h1>
        <a class="btn btn-secondary" href="/contacts">Back</a>
      </div>

      <form class="row g-3 mb-4" action="/users/add" method="post">
        <div class="col-md-4">
          <label class="form-label">Username</label>
          <input class="form-control" type="text" name="username" required />
        </div>
        <div class="col-md-4">
          <label class="form-label">Password</label>
          <input class="form-control" type="password" name="password" required />
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="isAdmin" name="isAdmin" />
            <label class="form-check-label" for="isAdmin">Admin</label>
          </div>
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <button class="btn btn-primary" type="submit">Add</button>
        </div>
      </form>

      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Username</th>
            <th class="text-center">Admin</th>
            <th>Created</th>
            <th>Created By</th>
            <th>New Password</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td>
                <input class="form-control" type="text" name="username" value="<%= u.username %>" form="edit-<%= u._id %>" required />
              </td>
              <td class="text-center">
                <input class="form-check-input" type="checkbox" name="isAdmin" form="edit-<%= u._id %>" <%= u.isAdmin ? 'checked' : '' %> />
              </td>
              <td><%= u.createdAt ? new Date(u.createdAt).toLocaleString('en-AU', { timeZone: 'Australia/Brisbane' }) : 'N/A' %></td>
              <td><%= u.createdBy || 'N/A' %></td>
              <td>
                <input class="form-control" type="password" name="password" placeholder="Password" form="edit-<%= u._id %>" />
              </td>
              <td>
                <div class="d-flex gap-2">
                  <button class="btn btn-sm btn-primary" type="submit" form="edit-<%= u._id %>">Save</button>
                  <% if (u.username !== currentUser) { %>
                    <form action="/users/<%= u._id %>/delete" method="post" onsubmit="return confirm('Delete user?');">
                      <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
            <form id="edit-<%= u._id %>" action="/users/<%= u._id %>/edit" method="post"></form>
          <% }) %>
        </tbody>
      </table>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
